# Enterprise IM local development environment template (NO real secrets)
APP_ENV=development
APP_NODE_ID=node-1

SERVER_ADDR=:8080
SERVER_SHUTDOWN_TIMEOUT=15s

WS_HEARTBEAT_TIMEOUT=75s
WS_WRITE_TIMEOUT=5s
WS_MAX_FRAME_BYTES=1048576

LOG_LEVEL=info
LOG_FORMAT=json

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=enterprise_im

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0

SNOWFLAKE_NODE_ID=1

JWT_SECRET=replace-with-32byte-jwt-secret-in-env
JWT_ISSUER=enterprise-im
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
AUTH_MAX_SESSIONS_PER_USER=5
AUTH_BCRYPT_COST=10

UPLOAD_DIR=./uploads
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_VOICE_BYTES=10485760
UPLOAD_MAX_AVATAR_BYTES=5242880
UPLOAD_MAX_IMAGE_WIDTH=8192
UPLOAD_MAX_IMAGE_HEIGHT=8192
UPLOAD_MAX_IMAGE_PIXELS=25000000
UPLOAD_MAX_VOICE_DURATION_MS=300000
UPLOAD_THUMBNAIL_MAX_DIM=320
UPLOAD_DOWNLOAD_URL_TTL=15m

CHAT_RECALL_WINDOW=2m

MQ_STREAM_MAX_LEN=100000
MQ_STREAM_RETENTION=168h
MQ_TRIM_INTERVAL=5m
MQ_READ_COUNT=100
MQ_BLOCK_TIMEOUT=2s
MQ_RECLAIM_INTERVAL=30s
MQ_RECLAIM_MIN_IDLE=30s
MQ_MAX_RETRIES=5
MQ_MAX_PENDING_AGE=15m
MQ_DEAD_STREAM_MAX_LEN=50000
MQ_PENDING_RECLAIM_TTL=24h
MQ_IDEMPOTENCY_TTL=24h
MQ_WORKER_COUNT=1
MQ_LARGE_GROUP_RECEIPT_THRESHOLD=100
