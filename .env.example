# Enterprise IM local development environment template (NO real secrets)
APP_ENV=development
APP_NODE_ID=node-1

SERVER_ADDR=:8080
SERVER_SHUTDOWN_TIMEOUT=15s

WS_HEARTBEAT_TIMEOUT=75s
WS_WRITE_TIMEOUT=5s
WS_MAX_FRAME_BYTES=1048576

LOG_LEVEL=info
LOG_FORMAT=json

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=enterprise_im

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0

SNOWFLAKE_NODE_ID=1

JWT_SECRET=replace-with-32byte-jwt-secret-in-env
JWT_ISSUER=enterprise-im
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
AUTH_MAX_SESSIONS_PER_USER=5
AUTH_BCRYPT_COST=10
CHAT_RECALL_WINDOW=2m
